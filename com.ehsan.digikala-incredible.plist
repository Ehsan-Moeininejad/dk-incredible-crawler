<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ehsan.digikala-incredible</string>

    <!-- Paths below point at the real project location. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ehsanmoeininejad/Documents/digikalAmazingcrowler/digikala-incredible-crawler/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ehsanmoeininejad/Documents/digikalAmazingcrowler/digikala-incredible-crawler</string>

    <!-- 00:00, 08:00 and 12:00 Tehran local time, every day -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/ehsanmoeininejad/Documents/digikalAmazingcrowler/digikala-incredible-crawler/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/ehsanmoeininejad/Documents/digikalAmazingcrowler/digikala-incredible-crawler/logs/launchd.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
